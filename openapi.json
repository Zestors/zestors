{
  "openapi": "3.1.0",
  "info": {
    "title": "",
    "version": ""
  },
  "paths": {
    "/tree": {
      "get": {
        "operationId": "get_tree",
        "parameters": [
          {
            "name": "include_debug",
            "in": "query",
            "description": "Whether to include debug state in the supervision tree",
            "required": false,
            "schema": {
              "type": ["boolean", "null"]
            }
          },
          {
            "name": "pid",
            "in": "query",
            "description": "The PID from which to start the supervision tree. If not provided, the root supervisor will be used.",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/String"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupervisionTree"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActorStatus": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["initializing"]
              }
            }
          },
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["running"]
              }
            }
          },
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["suspended"]
              }
            }
          },
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["exiting"]
              }
            }
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/Exit"
              },
              {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["dead"]
                  }
                }
              }
            ]
          }
        ]
      },
      "ChannelSnapshot": {
        "type": "object",
        "required": ["pid", "status", "signal_len", "msg_len", "spawns", "exits", "created_at"],
        "properties": {
          "created_at": {
            "$ref": "#/components/schemas/String"
          },
          "exits": {
            "type": "array",
            "items": {
              "type": "array",
              "items": false,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["Normal"]
                    },
                    {
                      "type": "object",
                      "required": ["Error"],
                      "properties": {
                        "Error": {
                          "$ref": "#/components/schemas/ExitError"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          },
          "msg_len": {
            "type": "integer",
            "minimum": 0
          },
          "pid": {
            "$ref": "#/components/schemas/String"
          },
          "signal_len": {
            "type": "integer",
            "minimum": 0
          },
          "spawns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/String"
            }
          },
          "status": {
            "$ref": "#/components/schemas/ActorStatus"
          }
        }
      },
      "ChildDescription": {
        "type": "object",
        "required": ["pid", "cfg"],
        "properties": {
          "cfg": {
            "$ref": "#/components/schemas/SuperviseeConfig"
          },
          "pid": {
            "$ref": "#/components/schemas/String"
          }
        }
      },
      "DebugState": {
        "type": "string",
        "format": "string",
        "example": "MyActor is running"
      },
      "DurationSchema": {
        "type": "object",
        "required": ["secs", "nanos"],
        "properties": {
          "nanos": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "secs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "example": "{\"secs\": 5, \"nanos\": 0}"
      },
      "Exit": {
        "oneOf": [
          {
            "type": "string",
            "enum": ["Normal"]
          },
          {
            "type": "object",
            "required": ["Error"],
            "properties": {
              "Error": {
                "$ref": "#/components/schemas/ExitError"
              }
            }
          }
        ]
      },
      "ExitError": {
        "type": "string",
        "enum": ["Panic", "Abort", "UnhandledError"]
      },
      "RestartMode": {
        "type": "string",
        "enum": ["Always", "OnError", "Never"]
      },
      "String": {
        "type": "string"
      },
      "SuperviseeConfig": {
        "type": "object",
        "required": ["restart_mode", "abort_timeout", "init_timeout"],
        "properties": {
          "abort_timeout": {
            "$ref": "#/components/schemas/DurationSchema"
          },
          "init_timeout": {
            "$ref": "#/components/schemas/DurationSchema"
          },
          "restart_mode": {
            "$ref": "#/components/schemas/RestartMode"
          }
        }
      },
      "SupervisionTree": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "channel_state": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ChannelSnapshot"
              }
            ]
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SupervisionTree"
            }
          },
          "debug_state": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DebugState"
              }
            ]
          },
          "description": {
            "$ref": "#/components/schemas/ChildDescription"
          },
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ActorStatus"
              }
            ]
          }
        }
      }
    }
  }
}
